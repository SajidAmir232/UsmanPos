@inherits LayoutComponentBase
@inject WebAuthService WebAuth
@inject NavigationManager Nav
@inject OfflineSyncService OfflineSync
@inject KeyboardShortcutService KeyboardService
@implements IDisposable

@if (!WebAuth.IsLoggedIn && !IsPublicPage)
{
    <POSApp.Web.Components.Pages.Login />
}
else if (!WebAuth.IsLoggedIn && IsPublicPage)
{
    @Body
}
else
{
    <div class="page" @onkeydown="HandleKeyboardEvent" tabindex="-1">
        <div class="sidebar @(isSidebarCollapsed ? "collapsed" : "")">
            <div class="sidebar-header">
                <div class="brand" @onclick="ToggleSidebar" style="cursor:pointer;">
                    <div class="logo-section">
                        <div class="logo-icon">POS</div>
                        <div class="logo-text">
                            <span class="logo-title">POS System</span>
                            <span class="logo-subtitle">Dashboard</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="toggle-btn" @onclick="ToggleSidebar" title="@(isSidebarCollapsed ? "Expand" : "Collapse")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        @if (isSidebarCollapsed)
                        {
                            <path d="M9 18l6-6-6-6"></path>
                        }
                        else
                        {
                            <path d="M15 18l-6-6 6-6"></path>
                        }
                    </svg>
                </button>
            </div>

            <nav class="nav-menu">
                <!-- Main Section -->
                <div class="nav-section">
                    <NavLink href="" Match="NavLinkMatch.All" class="nav-link" title="Dashboard">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                        </span>
                        <span class="label">Dashboard</span>
                    </NavLink>
                </div>

                <!-- Sales & POS Section -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Sales & POS</div>
                <div class="nav-section">
                    <NavLink href="pos" class="nav-link" title="New Sale">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                        </span>
                        <span class="label">New Sale (POS)</span>
                    </NavLink>
                    <NavLink href="sales" class="nav-link" title="Sales List">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <polyline points="19 12 12 19 5 12"></polyline>
                            </svg>
                        </span>
                        <span class="label">Sales List</span>
                    </NavLink>
                    <NavLink href="sales-returns" class="nav-link" title="Sales Returns">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </span>
                        <span class="label">Sales Returns</span>
                    </NavLink>
                </div>

                <!-- Products & Inventory Section -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Inventory</div>
                <div class="nav-section">
                    <NavLink href="products" class="nav-link" title="Products">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                        </span>
                        <span class="label">Products</span>
                    </NavLink>
                    <NavLink href="purchases" class="nav-link" title="Purchases">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 3L5 7m0 0L1 11M5 7l4 4M5 7v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7"></path>
                            </svg>
                        </span>
                        <span class="label">Purchases</span>
                    </NavLink>
                    <NavLink href="purchase-new" class="nav-link" title="New Purchase">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                        <span class="label">New Purchase</span>
                    </NavLink>
                </div>

                <!-- Customers Section -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Customers & Payments</div>
                <div class="nav-section">
                    <NavLink href="customers" class="nav-link" title="Customers">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <span class="label">Customers</span>
                    </NavLink>
                    <NavLink href="customer-payments" class="nav-link" title="Customer Payments">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <path d="M1 10h22"></path>
                            </svg>
                        </span>
                        <span class="label">Customer Payments</span>
                    </NavLink>
                    <NavLink href="customer-ledger" class="nav-link" title="Customer Ledger">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 7h16M4 12h16M4 17h16"></path>
                            </svg>
                        </span>
                        <span class="label">Customer Ledger</span>
                    </NavLink>
                </div>

                <!-- Suppliers Section -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Suppliers</div>
                <div class="nav-section">
                    <NavLink href="suppliers" class="nav-link" title="Suppliers">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <span class="label">Suppliers</span>
                    </NavLink>
                    <NavLink href="supplier-payments" class="nav-link" title="Supplier Payments">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <path d="M1 10h22"></path>
                            </svg>
                        </span>
                        <span class="label">Supplier Payments</span>
                    </NavLink>
                </div>

                <!-- Special Operations -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Operations</div>
                <div class="nav-section">
                    <NavLink href="imei-management" class="nav-link" title="IMEI Management">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                <line x1="9" y1="9" x2="15" y2="9"></line>
                            </svg>
                        </span>
                        <span class="label">IMEI Management</span>
                    </NavLink>
                    <NavLink href="repair-jobs" class="nav-link" title="Repair Jobs">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 1 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                            </svg>
                        </span>
                        <span class="label">Repair Jobs</span>
                    </NavLink>
                </div>

                <!-- Reports & Analytics -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Reports</div>
                <div class="nav-section">
                    <NavLink href="reports" class="nav-link" title="Reports">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="2" x2="12" y2="22"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </span>
                        <span class="label">Reports</span>
                    </NavLink>
                </div>

                <!-- Settings Section (Bottom) -->
                <div class="nav-divider"></div>
                <div class="nav-section-label">Admin</div>
                <div class="nav-section">
                    <NavLink href="settings" class="nav-link" title="Settings">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m3.08 3.08l4.24 4.24M1 12h6m6 0h6m-16.78 7.78l4.24-4.24m3.08-3.08l4.24-4.24"></path>
                            </svg>
                        </span>
                        <span class="label">Settings</span>
                    </NavLink>
                    @if (WebAuth.CurrentUser?.Role == "Admin")
                    {
                        <NavLink href="admin" class="nav-link" title="Admin Panel">
                            <span class="icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"></path>
                                </svg>
                            </span>
                            <span class="label">Admin Panel</span>
                        </NavLink>
                    }
                </div>
            </nav>
        </div>

        <main>
            <div class="topbar">
                <h1>@(PageTitle ?? "POS Dashboard")</h1>
                <div class="user-info" style="display:flex;align-items:center;gap:12px;">
                    <span style="display:inline-flex;align-items:center;gap:6px;font-size:11px;padding:3px 10px;border-radius:20px;background:@(OfflineSync.IsOnline ? "#d1fae5" : "#fee2e2");color:@(OfflineSync.IsOnline ? "#065f46" : "#991b1b");font-weight:600;">
                        <span style="width:6px;height:6px;border-radius:50%;background:@(OfflineSync.IsOnline ? "#10b981" : "#ef4444");display:inline-block;"></span>
                        @(OfflineSync.IsOnline ? "Online" : "Offline")
                    </span>
                    @(WebAuth.CurrentUser?.Username ?? "Admin") | @(WebAuth.CurrentUser?.Role ?? "Admin")
                    <button id="keyboard-guide-button" class="btn btn-ghost btn-sm" style="margin-left:8px;font-size:11px;" @onclick="ToggleShortcutGuide">⌘ Guide</button>
                    <button class="btn btn-ghost btn-sm" style="font-size:11px;" @onclick="Logout">Logout</button>
                </div>
            </div>
            <div class="content">
                @Body
            </div>
        </main>
    </div>
}

@if (showShortcutGuide)
{
    <div class="shortcut-guide-overlay" @onclick="() => showShortcutGuide = false">
        <div class="shortcut-guide-panel" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="shortcut-guide-header">
                <div>
                    <h2 style="margin: 0; font-size: 18px;">⌨️ Keyboard Shortcuts</h2>
                    <p style="margin: 4px 0 0 0; font-size: 12px; opacity: 0.9;">Press <span class="kbd-hint">ESC</span> to close</p>
                </div>
                <button class="btn-close" @onclick="() => showShortcutGuide = false" aria-label="Close">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="shortcut-guide-content">
                @if (currentShortcuts.Count == 0)
                {
                    <div class="empty-state">
                        <p>No shortcuts configured for this page.</p>
                    </div>
                }
                else
                {
                    @foreach (var category in currentShortcuts.GroupBy(s => s.Category))
                    {
                        <div class="shortcut-category">
                            <div class="shortcut-category-title">@GetCategoryName(category.Key)</div>
                            <div class="shortcuts-list">
                                @foreach (var shortcut in category.OrderBy(s => s.KeyCombination))
                                {
                                    <div class="shortcut-item">
                                        <div class="shortcut-keys">
                                            @foreach (var key in shortcut.KeyCombination.Split('+'))
                                            {
                                                <span class="shortcut-key">@key.ToUpper()</span>
                                            }
                                        </div>
                                        <span class="shortcut-desc">@shortcut.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">&#10005;</a>
</div>

@code {
    [CascadingParameter]
    private string? PageTitle { get; set; }

    private bool IsPublicPage => Nav.Uri.Contains("/login") || Nav.Uri.Contains("/forgot-password") || Nav.Uri.Contains("/signup");
    private string currentContext = "global";
    private bool isSidebarCollapsed = false;
    private bool showShortcutGuide = false;
    private List<ShortcutHandler> currentShortcuts = new();

    protected override void OnInitialized()
    {
        WebAuth.OnAuthStateChanged += StateHasChanged;
        OfflineSync.OnSyncStateChanged += StateHasChanged;
        KeyboardService.OnShortcut += HandleShortcut;
        _ = OfflineSync.InitializeAsync();
        UpdateContextFromUrl();
        UpdateShortcutsList();
        Nav.LocationChanged += (s, e) => OnLocationChanged();
    }

    private void OnLocationChanged()
    {
        UpdateContextFromUrl();
        UpdateShortcutsList();
    }

    private void UpdateContextFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.LocalPath.TrimStart('/').Split('/')[0];
        
        currentContext = path switch
        {
            "" => "home",
            "pos" => "pos",
            "products" => "products",
            "customers" => "customers",
            "suppliers" => "suppliers",
            "purchases" => "purchases",
            "sales" => "sales",
            "reports" => "reports",
            "settings" => "settings",
            "admin" => "admin",
            _ => "global"
        };

        KeyboardService.SetContext(currentContext);
    }

    private void UpdateShortcutsList()
    {
        currentShortcuts = KeyboardService.GetShortcutsForContext(currentContext)
            .OrderBy(s => s.Category)
            .ThenBy(s => s.KeyCombination)
            .ToList();
    }

    private void HandleShortcut(ShortcutEvent @event)
    {
        if (@event.Action == "show-guide")
        {
            showShortcutGuide = !showShortcutGuide;
            StateHasChanged();
        }
        else if (@event.Action == "navigate")
        {
            Nav.NavigateTo(@event.Value);
        }
        else if (@event.Action == "close-modal")
        {
            showShortcutGuide = false;
            StateHasChanged();
        }
        else if (@event.Action == "logout")
        {
            Logout();
        }
        else
        {
            // Page-specific actions handled by individual pages via cascading parameters
            // or by dispatching through a message service if needed
        }
    }

    private string GetCategoryName(ShortcutCategory category) => category switch
    {
        ShortcutCategory.Navigation => "🗺️ Navigation",
        ShortcutCategory.Action => "⚙️ Actions",
        ShortcutCategory.Focus => "📍 Focus",
        ShortcutCategory.Help => "❓ Help",
        _ => "Other"
    };

    public void Dispose()
    {
        WebAuth.OnAuthStateChanged -= StateHasChanged;
        OfflineSync.OnSyncStateChanged -= StateHasChanged;
        KeyboardService.OnShortcut -= HandleShortcut;
        Nav.LocationChanged -= (s, e) => OnLocationChanged();
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private async Task HandleKeyboardEvent(KeyboardEventArgs e)
    {
        // Skip if typing in input fields (unless using Ctrl/Alt/Shift)
        bool isModifierKey = e.CtrlKey || e.AltKey || e.ShiftKey || e.MetaKey;
        
        if (e.Key == "/" && e.CtrlKey)
        {
            e.PreventDefault();
            showShortcutGuide = !showShortcutGuide;
            StateHasChanged();
            return;
        }
        
        if (e.Key == "?" && !isModifierKey)
        {
            e.PreventDefault();
            showShortcutGuide = !showShortcutGuide;
            StateHasChanged();
            return;
        }

        if (e.Key == "Escape")
        {
            e.PreventDefault();
            showShortcutGuide = false;
            StateHasChanged();
            return;
        }

        // Handle other keyboard shortcuts
        bool handled = KeyboardService.HandleKeyDown(e.Key, e.CtrlKey, e.ShiftKey, e.AltKey);
        
        if (handled)
        {
            e.PreventDefault();
            StateHasChanged();
        }
    }

    private void ToggleShortcutGuide()
    {
        showShortcutGuide = !showShortcutGuide;
    }

    private void Logout()
    {
        WebAuth.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
